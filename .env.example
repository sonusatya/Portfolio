# ============================================================
#  Sonu Kumar Portfolio — Environment Template
#  Copy this file to `.env` in the SAME folder and fill values.
#  `.env` is git-ignored. NEVER commit real secrets.
# ============================================================

# ---------- SERVER (server/.env) ----------
# Port the Express API runs on
PORT=4000

# MongoDB Atlas connection string (free M0 cluster)
# Create at https://cloud.mongodb.com → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sonu-portfolio?retryWrites=true&w=majority

# Secret used to sign admin JWT tokens. Use a long random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Admin login credentials (seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# Google AI Studio API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which LLM model to use for the AI assistant
GEMINI_MODEL=gemini-2.0-flash

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173

# ---------- CLIENT (client/.env) ----------
# Base URL of the backend API
VITE_API_URL=http://localhost:4000
